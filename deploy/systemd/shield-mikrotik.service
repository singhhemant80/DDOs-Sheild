[Unit]
Description=Crapplet DDoS Shield MikroTik poller (read-only)
After=network-online.target postgresql.service redis-server.service clickhouse-server.service shield-api.service
Wants=network-online.target

[Service]
Type=exec
User=shield
Group=shield
WorkingDirectory=/opt/crapplet-shield/backend
EnvironmentFile=/etc/crapplet-shield/shield.env
ExecStart=/opt/crapplet-shield/venv/bin/python -m app.mikrotik
Restart=always
RestartSec=5
# Reads only: the RouterOS client refuses any command that is not a print. Router passwords are
# decrypted in memory with SHIELD_CREDENTIAL_KEY and never written to logs.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
