[Unit]
Description=Crapplet DDoS Shield: refresh the IP-to-ASN table (names the networks attacks come from)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=shield
Group=shield
WorkingDirectory=/opt/crapplet-shield/backend
EnvironmentFile=/etc/crapplet-shield/shield.env
ExecStart=/opt/crapplet-shield/venv/bin/python -m app.cli update-asn
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crapplet-shield
